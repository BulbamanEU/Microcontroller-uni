/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_SPI4_Init();
  MX_FMC_Init();
  MX_I2C3_Init();
  /* USER CODE BEGIN 2 */
  BSP_LCD_Init();
    BSP_LCD_LayerDefaultInit(1, LCD_FB_START_ADDRESS);
    BSP_LCD_SelectLayer(1);
    BSP_LCD_DisplayOn();
    BSP_LCD_Clear(LCD_COLOR_WHITE);
    BSP_LCD_SetTextColor(LCD_COLOR_BLACK);
    BSP_LCD_SetBackColor(LCD_COLOR_WHITE);
    BSP_LCD_SetFont(&Font16);

    BSP_LCD_DisplayStringAt(0, 10, (uint8_t*)"SPI4 Loopback Test", CENTER_MODE);

  HAL_StatusTypeDef status;
  status = HAL_SPI_TransmitReceive(&hspi4, tx_data, rx_data, 4, 100);

  if (HAL_SPI_TransmitReceive(&hspi4, tx_data, rx_data, 4, 1000) == HAL_OK)
    {
        // Jei pavyko, išvedame į ekraną
        BSP_LCD_SetTextColor(LCD_COLOR_GREEN);
        BSP_LCD_DisplayStringAt(0, 50, (uint8_t*)"Status: OK", CENTER_MODE);

        for(int i = 0; i < 4; i++) {
            sprintf(uart_buf, "TX[%d]:%d -> RX[%d]:%d", i, tx_data[i], i, rx_data[i]);
            BSP_LCD_DisplayStringAt(0, 80 + (i*20), (uint8_t*)uart_buf, CENTER_MODE);
        }
    }
    else
    {
        BSP_LCD_SetTextColor(LCD_COLOR_RED);
        BSP_LCD_DisplayStringAt(0, 50, (uint8_t*)"Status: ERROR", CENTER_MODE);
    }
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

