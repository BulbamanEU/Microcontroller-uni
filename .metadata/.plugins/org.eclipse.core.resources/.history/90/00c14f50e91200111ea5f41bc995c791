/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  /* USER CODE BEGIN 2 */
  //GPIO_Init();

  int task = 4;
  uint32_t seconds = 0;

  uint8_t last_state = 0; // paskutine vartotojo mygtuko busena

  uint32_t current_tick = 0;
  uint32_t last_tick = 0;
  uint32_t set_tick_speed = 1000; //tick speed
  uint8_t button_was_pressed = 0; //pagalbinis stebeti ar mygtukas buvo paspaustas

  RCC->AHB1ENR |= (1 << 6); // ijungiamas laikrodis

  // MODER registre kiekvienai kojelei skiriami 2 bitai.
  // 13-ai kojelei tai 26 ir 27 bitai. Reikšmė "01" reiškia Output.
  GPIOG->MODER &= ~(3 << (13 * 2)); // Išvalome bitus
  GPIOG->MODER |= (1 << (13 * 2));  // Nustatome į 01


  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */

	// Zalias ir raudonas mirksi kombinacijomis 0,1,2,3
	if(task == 1){
		// nunulina 13 ir 14 LED'us
		GPIOG->ODR &= ~(1 << 13);
		GPIOG->ODR &= ~(1 << 14);
		HAL_Delay(250);
		// XOR operatorius apverčia 14-ą bitą
		GPIOG->ODR ^= (1 << 14);
		HAL_Delay(250);
		GPIOG->ODR ^= (1 << 13);
		GPIOG->ODR ^= (1 << 14);
		HAL_Delay(250);
		GPIOG->ODR ^= (1 << 14);
		HAL_Delay(250);
	}

	//raudonas kas 1 sekunde, zalias kas 2 sekundes
	if (task == 2){
		// Raudonas LED (PG14) mirksi kas 1 sekundę (keičia būseną kas sekundę)
		GPIOG->ODR ^= (1 << 14);

		// Žalias LED (PG13) mirksi kas 2 sekundes (keičia būseną kas antrą ciklą)
		if (seconds % 2 == 0)
		{
			GPIOG->ODR ^= (1 << 13);
		}

		HAL_Delay(1000); // Palaukiame 1 sekundę
		seconds++;      // Didiname skaitiklį
	}

	if (task == 3){
		// Nuskaitome dabartinę PA0 būseną (1 - nuspaustas, 0 - ne)
		// Naudojame bito kaukę (1 << 0) nuliui bitui
		uint8_t current_state = (GPIOA->IDR & (1 << 0)) ? 1 : 0;

		//tikriname ar paspaustas mygtukas (toggle)
		if (current_state == 1 && last_state == 0) {
			GPIOG->ODR ^= (1 << 13);
		}

		last_state = current_state;

		HAL_Delay(20);
	}

	if (task==4){
		uint8_t current_state = (GPIOA->IDR & (1 << 0)) ? 1 : 0;
		current_tick = my_ms_ticks;
		/* red LED (PG14) - flashes every 1 s */
		if (current_tick - last_tick >= set_tick_speed)
		{
			GPIOG->ODR ^= (1 << 14);
			last_tick = current_tick;
		}

		if (current_state == 1 && last_state == 0)
		{
			/* set green LED on */
			GPIOG->ODR ^= (1<<13);
			set_tick_speed = set_tick_speed + 1000;
		}

		last_state = current_state;
	}
  }
  /* USER CODE END 3 */
}

